generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 카테고리 (기본 제공 + 사용자 정의, 대분류/소분류 지원)
model BudgetCategory {
  id           String                    @id @default(cuid())
  name         String
  type         String // "income" | "expense"
  icon         String?
  color        String?
  isDefault    Boolean                   @default(false)
  parentId     String? // 대분류 ID (null이면 대분류, 있으면 소분류)
  parent       BudgetCategory?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     BudgetCategory[]          @relation("CategoryHierarchy")
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  transactions BudgetTransaction[]
  templates    BudgetRecurringTemplate[]
}

// 수입/지출 거래
model BudgetTransaction {
  id            String         @id @default(cuid())
  type          String // "income" | "expense"
  amount        Float
  description   String?
  date          DateTime
  categoryId    String
  category      BudgetCategory @relation(fields: [categoryId], references: [id])
  paymentMethod String? // "현대카드" | "신한카드" | "계좌이체" | "현금" 등
  user          String? // "지완" | "지아"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// 고정 지출 템플릿
model BudgetRecurringTemplate {
  id          String         @id @default(cuid())
  name        String
  type        String // "income" | "expense"
  amount      Float
  description String?
  categoryId  String
  category    BudgetCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ============================================
// 자산 관리 시스템 (신규)
// ============================================

// 금융기관
model Institution {
  id        String    @id @default(cuid())
  name      String    @unique // "농협은행", "나무증권"
  type      String // "bank" | "brokerage"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
}

// 가족 구성원
model Member {
  id        String    @id @default(cuid())
  name      String    @unique // "지완", "지아"
  color     String? // UI 표시용
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
}

// 자산 마스터 (종목 정의)
model AssetMaster {
  id     String  @id @default(cuid())
  name   String // "삼성전자", "S&P 500 ETF"
  symbol String? // 티커: "005930", "SPY" (선택)

  // 분류 (컬럼으로 관리 - 자주 조회/그룹화)
  assetClass String // "주식" | "채권" | "예금" | "금" | "코인"
  subClass   String? // "성장" | "배당" | "국채" | "회사채"
  riskLevel  String  @default("위험자산") // "위험자산" | "안전자산"
  currency   String  @default("KRW") // "KRW" | "USD"

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings Holding[]

  @@unique([name, currency])
}

// 계좌
model Account {
  id            String      @id @default(cuid())
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  name        String // "급여통장", "연금저축 나무"
  accountType String // "예금" | "적금" | "청약" | "종합" | "CMA" | "IRP" | "ISA" | "연금저축" | "코인" | "금현물"
  currency    String @default("KRW")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings      Holding[]
  cashSnapshots CashSnapshot[]

  @@index([memberId])
  @@index([institutionId])
}

// 보유 종목 (계좌×종목 연결 단위. 현재 상태는 최신 스냅샷에서 파생)
model Holding {
  id            String      @id @default(cuid())
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id])
  assetMasterId String
  assetMaster   AssetMaster @relation(fields: [assetMasterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots    HoldingSnapshot[]
  transactions HoldingTransaction[]

  @@unique([accountId, assetMasterId])
  @@index([accountId])
}

// 매수/매도 거래 (비권위 보조 — Holding·스냅샷을 자동 갱신하지 않음)
model HoldingTransaction {
  id        String  @id @default(cuid())
  holdingId String
  holding   Holding @relation(fields: [holdingId], references: [id])

  transactionType String // "buy" | "sell" | "dividend" | "transfer_in" | "transfer_out"
  date            DateTime
  quantity        Float // 매수 +, 매도 -
  priceOriginal   Float
  exchangeRate    Float?
  priceKRW        Float
  totalKRW        Float
  notes           String?

  createdAt DateTime @default(now())

  @@index([holdingId])
  @@index([date])
}

// 보유 종목 스냅샷 — 투자 자산의 단일 진실원천(SSOT)
model HoldingSnapshot {
  id        String  @id @default(cuid())
  holdingId String
  holding   Holding @relation(fields: [holdingId], references: [id])

  snapshotDate    DateTime // 스냅샷 기준일 (월말 기본, 주 단위 등 임의 시점 허용)
  quantity        Float
  avgCostKRW      Float    @default(0) // 평균단가(원화) → 원금 = quantity × avgCostKRW
  currentPriceKRW Float // 현재가(원화) → 평가액 = quantity × currentPriceKRW
  exchangeRate    Float? // 외화 종목의 적용 환율 (원화 종목은 null)
  priceOriginal   Float? // 원통화 현재가 (외화 입력값 보존, 원화 종목은 null)
  avgCostOriginal Float? // 원통화 평균단가 (외화 입력값 보존, 원화 종목은 null)

  createdAt DateTime @default(now())

  @@unique([holdingId, snapshotDate])
  @@index([snapshotDate])
}

// 계좌 현금 스냅샷 — 현금 자산의 단일 진실원천(SSOT)
model CashSnapshot {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  snapshotDate   DateTime // 스냅샷 기준일 (월말 기본, 주 단위 등 임의 시점 허용)
  cashBalanceKRW Float // 해당 시점 현금 잔고(원화)

  createdAt DateTime @default(now())

  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
}
